---
import { brandify } from '../lib/brand';
import { CONTACT_ENDPOINT } from '../data/contact';
import compBack300 from '../assets/shared/computer-back-300.webp?url';
import compBack500 from '../assets/shared/computer-back-500.webp?url';
import compBack750 from '../assets/shared/computer-back-750.webp?url';
import compBack1000 from '../assets/shared/computer-back-1000.webp?url';
import compBack1600 from '../assets/shared/computer-back-1600.webp?url';
import compBack2000 from '../assets/shared/computer-back-2000.webp?url';
import compFront300 from '../assets/shared/computer-front-300.webp?url';
import compFront500 from '../assets/shared/computer-front-500.webp?url';
import compFront750 from '../assets/shared/computer-front-750.webp?url';
import compFront1000 from '../assets/shared/computer-front-1000.webp?url';
import compFront1600 from '../assets/shared/computer-front-1600.webp?url';
import compFront2000 from '../assets/shared/computer-front-2000.webp?url';

const compBackSrcset = `${compBack300} 300w, ${compBack500} 500w, ${compBack750} 750w, ${compBack1000} 1000w, ${compBack1600} 1600w, ${compBack2000} 2000w`;
const compFrontSrcset = `${compFront300} 300w, ${compFront500} 500w, ${compFront750} 750w, ${compFront1000} 1000w, ${compFront1600} 1600w, ${compFront2000} 2000w`;

interface Props {
  /** Smiley sentence; the original CMS serves the singular form on /services. */
  smileyCopy?: string;
  /** sr-only section H2 (aria-labelledby target). */
  srHeading?: string;
  /** Two giant display words above the form. */
  headingParts?: readonly [string, string];
}
const {
  smileyCopy = 'We’re a technology and creative partner that puts your customers first. Drop us a message!',
  srHeading = 'Begin your story',
  headingParts = ['Begin your', 'story'],
} = Astro.props;
const smileyHtml = brandify(smileyCopy);
---
<section
  id="contact"
  class="sections-contactForm relative bg-darkPurple pt-40 2xl:pt-32"
  aria-labelledby="contactForm-heading"
  ><div class="relative mx-auto flex w-full max-w-1920 flex-col overflow-hidden"
    ><span
      class="parts-smileyText relative z-3 mx-14 mb-90 w-10/12 max-w-480 heading text-white lg:mb-120 2xl:mr-0 2xl:mb-150 2xl:ml-60 2xl:w-full 2xl:max-w-485"
      style="font-kerning: none; text-rendering: optimizeSpeed"
    ><span class="sr-only" set:html={smileyHtml} /><span
      aria-hidden="true"
      role="presentation"
      style="font-kerning: none; text-rendering: optimizeSpeed"
      set:html={smileyHtml}
    /></span
    ><h2 id="contactForm-heading" class="sr-only">{srHeading}</h2
    ><div class="relative z-1 mx-14 mb-48 flex flex-col heading-3xl text-neonGreen uppercase 2xl:mx-0 2xl:mb-150"
      ><span
        class="sections-contactForm__headingLeft font-offBit101 font-normal whitespace-nowrap 2xl:-mb-30"
        aria-hidden="true"
        role="presentation"
        >{headingParts[0]}</span
      ><span class="sections-contactForm__headingRight font-offBit text-white">{headingParts[1]}</span></div
    ><form
      novalidate
      method="POST"
      action={CONTACT_ENDPOINT || undefined}
      aria-labelledby="form-title"
      class="parts-form -mb-20 rounded-t-10 bg-white px-27 pt-25 pb-20 lg:rounded-t-16 lg:px-54 lg:pt-34 lg:pb-100 sections-contactForm__form z-10 mx-auto w-11/12 origin-bottom lg:origin-bottom-left 2xl:absolute 2xl:right-120 2xl:bottom-0 2xl:ml-0 2xl:w-[38%] 2xl:-translate-x-60"
      aria-describedby="status-message"
      ><input
        type="text"
        name="_gotcha"
        class="sr-only"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      /><input
        type="hidden"
        name="_email.subject"
        value="New enquiry from decbricks.com"
      /><input
        type="hidden"
        name="source_page"
        value=""
      /><div class="mb-15 flex items-center gap-15 lg:mb-50"
        ><svg
          class="svgs-doubleSlash block w-22 min-w-22 text-darkPurple"
          viewBox="0 0 18 10"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <rect
            x="8"
            y="9.27246"
            width="3.09091"
            height="3.09091"
            transform="rotate(-90 8 9.27246)"
            fill="currentColor"
          />
          <rect
            x="11.0938"
            y="6.18066"
            width="3.09091"
            height="3.09091"
            transform="rotate(-90 11.0938 6.18066)"
            fill="currentColor"
          />
          <rect
            x="14.1797"
            y="3.09082"
            width="3.09091"
            height="3.09091"
            transform="rotate(-90 14.1797 3.09082)"
            fill="currentColor"
          />
          <rect y="9.27246" width="3.09091" height="3.09091" transform="rotate(-90 0 9.27246)" fill="currentColor" />
          <rect
            x="3.09375"
            y="6.18066"
            width="3.09091"
            height="3.09091"
            transform="rotate(-90 3.09375 6.18066)"
            fill="currentColor"
          />
          <rect
            x="6.17969"
            y="3.09082"
            width="3.09091"
            height="3.09091"
            transform="rotate(-90 6.17969 3.09082)"
            fill="currentColor"
          /></svg
        ><h3 id="form-title" class="heading-sm text-darkPurple uppercase">Get In Touch</h3></div
      ><fieldset class="u-ink mb-20 flex w-full flex-col gap-10 text-darkPurple"
        ><legend class="sr-only">Contact Information</legend
        ><div class="parts-formInput w-full"
          ><label for="email" class="sr-only">Email</label
          ><div class="relative"
            ><input
              id="email"
              name="email"
              value={'' as any}
              type="email"
              required
              placeholder="Email"
              class="border-transparent hover:border-purple focus:border-purple focus:outline-purple block w-full rounded-6 border-2 bg-purple/10 px-22 py-16 subheading text-inherit uppercase placeholder-inherit transition-colors duration-300 focus:ring-0 max-lg:text-[16px]"
              aria-invalid="false"
              autocomplete="email" /></div
          ><p class="form-fieldError" id="email-error" hidden></p></div
        ><div class="parts-formInput w-full"
          ><label for="name" class="sr-only">Name</label
          ><div class="relative"
            ><input
              id="name"
              name="name"
              value={'' as any}
              type="text"
              required
              placeholder="Name"
              class="border-transparent hover:border-purple focus:border-purple focus:outline-purple block w-full rounded-6 border-2 bg-purple/10 px-22 py-16 subheading text-inherit uppercase placeholder-inherit transition-colors duration-300 focus:ring-0 max-lg:text-[16px]"
              aria-invalid="false"
              autocomplete="name" /></div
          ><p class="form-fieldError" id="name-error" hidden></p></div
        ><div class="parts-formInput w-full"
          ><label for="company" class="sr-only">Company</label
          ><div class="relative"
            ><input
              id="company"
              name="company"
              value={'' as any}
              type="text"
              required
              placeholder="Company"
              class="border-transparent hover:border-purple focus:border-purple focus:outline-purple block w-full rounded-6 border-2 bg-purple/10 px-22 py-16 subheading text-inherit uppercase placeholder-inherit transition-colors duration-300 focus:ring-0 max-lg:text-[16px]"
              aria-invalid="false"
              autocomplete="organization" /></div
          ><p class="form-fieldError" id="company-error" hidden></p></div
        ><div class="parts-formTextarea w-full"
          ><label for="message" class="sr-only">Message</label
          ><div class="relative">
            <textarea
              id="message"
              name="message"
              type="text"
              placeholder="Message"
              class="border-transparent hover:border-purple focus:border-purple focus:outline-purple block min-h-164 w-full rounded-6 bg-purple/10 px-22 py-16 subheading text-darkPurple uppercase placeholder-darkPurple transition-colors duration-300 focus:ring-0 max-lg:text-[16px]"
              maxlength="5000"
              aria-invalid="false"
            ></textarea></div
          ><p class="form-fieldError" id="message-error" hidden></p></div></fieldset
      ><div class="flex flex-col gap-12 lg:flex-row lg:items-start lg:justify-between"
        ><div class="parts-formCheckbox w-full lg:w-6/12" name="Terms and Conditions" is-valid="false"
          ><div class="flex items-center gap-10"
            ><label for="terms" class="relative mt-2 flex-shrink-0"
              ><input id="terms" name="terms" type="checkbox" required class="sr-only" aria-invalid="false" /><div
                class="border-darkPurple flex h-16 min-h-16 w-16 min-w-16 cursor-pointer items-center justify-center rounded-4 border transition-colors lg:h-21 lg:min-h-21 lg:w-21 lg:min-w-21"
              ><svg
                class="svgs-check block h-12 w-12 text-darkPurple opacity-0 transition-opacity duration-300"
                viewBox="0 0 13 10"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path fill="currentColor" d="M12.8 0v3.2H9.6V0zM9.6 3.2v3.2H6.4V3.2zM6.4 6.4v3.2H3.2V6.4z"></path>
                <path
                  fill="currentColor"
                  d="M6.4 9.6H3.2V6.4h3.2zM3.2 6.4H0V3.2h3.2z"
                ></path></svg></div></label
              ><div class="flex-1"
              ><label
                for="terms"
                class="u-ink text-darkPurple parts-formCheckbox__label block cursor-pointer copy-xs text-darkPurple"
                >I have read and agree to the <a href="/terms" target="_blank" rel="noopener">Terms of Service</a> and
                <a href="/terms#privacy-policy" target="_blank" rel="noopener">Privacy Policy</a>.</label
              ></div
            ></div
          ><p class="form-fieldError" id="terms-error" hidden></p
          ></div
        ><button
          aria-label="Submit"
          class="u-btn-primary part-btnPrimary group flex items-center justify-center gap-12 rounded-8 transition-colors duration-300 cursor-pointer bg-purple text-darkPurple active:bg-white flex-row px-14 py-11 lg:px-18 lg:py-16"
          ><div class="relative flex overflow-hidden"
            ><span class="part-btnPrimary__text uppercase btn-text">Submit</span
            ><span class="part-btnPrimary__text absolute inset-x-0 top-full text-center uppercase btn-text" aria-hidden="true"
              >Submit</span
            ></div
          ><svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 7 10"
            class="block w-6 min-w-6 lg:w-8 lg:min-w-8 lg:-mt-1"
          >
            <path
              fill="currentColor"
              d="M0 9.637V6.546h3.091v3.091zM3.094 6.546V3.455h3.09v3.09zM0 3.455V.365h3.09v3.09z"
            /></svg></button></div
      ><div id="status-message" aria-live="polite" aria-atomic="true" tabindex="-1" class="mt-20"></div></form></div
  ><div
    class="pointer-events-none absolute top-[10vw] left-[5vw] w-[120vw] max-w-1820 sm:right-[-10.4vw] sm:left-auto sm:w-[120vw] lg:top-[-10vw] lg:w-[95vw]"
    ><picture class="parts-webPicture"
      ><img
        alt=""
        src={compBack300}
        srcset={compBackSrcset}
        width="2000"
        height="1647"
        class="h-full w-full"
        sizes="100vw"
        loading="lazy"
        decoding="async"
        draggable="false" /></picture></div
  ><div
    class="pointer-events-none absolute top-[10vw] left-[5vw] z-2 w-[120vw] max-w-1820 sm:right-[-10.4vw] sm:left-auto sm:w-[120vw] lg:top-[-10vw] lg:w-[95vw]"
    ><picture class="parts-webPicture"
      ><img
        alt=""
        src={compFront300}
        srcset={compFrontSrcset}
        width="2000"
        height="1647"
        class="h-full w-full"
        sizes="100vw"
        loading="lazy"
        decoding="async"
        draggable="false" /></picture></div
></section>
