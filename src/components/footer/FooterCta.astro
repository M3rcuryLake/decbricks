---
import { FOOTER, FOOTER_CONTACT } from '../../data/footer';
import ActionButton from '../ActionButton.astro';

interface Props {
  show: boolean;
}

const { show } = Astro.props;
const hasCalLink = Boolean(FOOTER_CONTACT.cal.link);
const hasBooking = Boolean(hasCalLink || FOOTER_CONTACT.cal.bookingUrl);
const bookingHref = FOOTER_CONTACT.cal.bookingUrl || '/contact#book-a-call';
const bookingExternal = Boolean(FOOTER_CONTACT.cal.bookingUrl);
const calConfigJson = JSON.stringify({ layout: 'month_view' });
---

{
  show ? (
    <section class="structure-footer__cta" aria-labelledby="footer-cta-heading">
      <h2 id="footer-cta-heading" class="structure-footer__ctaTitle text-darkPurple">
        {FOOTER.cta.heading}
      </h2>
      <div class="structure-footer__ctaActions">
        <ActionButton
          label={FOOTER.cta.primary.label}
          href={FOOTER.cta.primary.href}
          variant="hero-light"
          class="structure-footer__ctaAction"
        />
        {hasBooking && (
          <ActionButton
            label={FOOTER.cta.bookingLabel}
            href={hasCalLink ? undefined : bookingHref}
            target={!hasCalLink && bookingExternal ? '_blank' : undefined}
            rel={!hasCalLink && bookingExternal ? 'noopener noreferrer' : undefined}
            variant="hero-light"
            class="structure-footer__ctaAction"
            data-cal-modal={hasCalLink ? 'true' : undefined}
            data-cal-link={hasCalLink ? FOOTER_CONTACT.cal.link : undefined}
            data-cal-namespace={hasCalLink ? FOOTER_CONTACT.cal.namespace : undefined}
            data-cal-config={hasCalLink ? calConfigJson : undefined}
          />
        )}
      </div>
    </section>
  ) : (
    <h2 id="footer-heading" class="sr-only">
      Site footer
    </h2>
  )
}
