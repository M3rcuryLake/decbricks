---
/**
 * Shared shell for the legal pages (/terms, /privacy-policy) — open-items A11.
 * Mirrors the 404 page's structure (Base → Header → .page → section → Footer)
 * with a single light content island styled with the compiled template's
 * existing classes — composed exclusively from classes that already ship in
 * the about/contact/404 islands (global.css is static precompiled output; a
 * new utility does nothing). No sidebar nav, no page logic — every init*()
 * in main.ts null-guards, so nothing needs registering there.
 *
 * DRAFT STATE: `noindex` stays on until the owner replaces the bracketed
 * placeholders and has the text reviewed (then flip this prop and add the
 * routes to src/pages/sitemap.xml.ts — see docs/open-items.md A11).
 */
import type { LegalDoc } from '../data/legal';
import { brandify } from '../lib/brand';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CookieBanner from './CookieBanner.astro';
import TransitionOverlay from './TransitionOverlay.astro';

interface Props {
  doc: LegalDoc;
}

const { doc } = Astro.props;
---

<Base title={doc.seoTitle} description={doc.seoDescription} noindex={true}>
  <main id="main-content" class="layout overflow-hidden bg-darkPurple">
    <div></div>
    <div class="page page-legal bg-darkPurple">
      <Header />
      {/* Dark themed strip: at scroll-0 the header sits on the page's darkPurple
          background, so the first themed element must be dark for the header's
          cream wordmark to be visible (same reason /about's hero is dark). */}
      <div data-theme="dark" class="h-10 bg-darkPurple" aria-hidden="true"></div>
      <section data-theme="light" class="relative overflow-hidden bg-darkPurple pt-80 lg:pt-100" aria-label={doc.title}>
        <div
          class="rounded-10 bg-white px-9 pt-10 pb-40 lg:rounded-24 lg:px-20 lg:pt-25 lg:pb-50 xl:px-25 xl:pt-30 xl:pb-60 3xl:px-35 3xl:pt-35 3xl:pb-70 4xl:px-35 4xl:pt-40 4xl:pb-80"
        >
          <div
            class="mx-auto flex w-full max-w-1850 flex-col gap-40 lg:gap-55 xl:gap-65"
          >
            <header class="flex flex-col gap-15 lg:max-w-1000">
              <p class="u-ink font-neuePower text-[12px] leading-none font-bold text-darkPurple uppercase" data-legal-draft-stamp>
                Last updated: {doc.updated}
              </p>
              <h1 class="heading-2xl font-normal text-darkPurple uppercase">{doc.title}</h1>
              <p class="u-ink copy-lg text-darkPurple">{doc.intro}</p>
            </header>
            <div class="flex flex-col gap-30 lg:max-w-1000 lg:gap-45">
              {
                doc.sections.map((section) => (
                  <section id={section.id} aria-labelledby={section.id}>
                    <h2 class="u-h2 mt-5 font-neuePower text-[22px] leading-[0.88] font-bold text-darkPurple uppercase lg:mt-10 lg:text-[36px] xl:text-[44px] 3xl:text-[52px] 4xl:text-[60px]">
                      {section.heading}
                    </h2>
                    <div class="mt-10 flex flex-col gap-12 lg:mt-15">
                      {section.body.map((paragraph) => <p class="u-ink copy-lg text-darkPurple" set:html={brandify(paragraph)} />)}
                      {section.bullets && (
                        <ul class="legal-list flex flex-col gap-8">
                          {section.bullets.map((item) => (
                            <li class="u-ink copy-lg text-darkPurple" set:html={brandify(item)} />
                          ))}
                        </ul>
                      )}
                    </div>
                  </section>
                ))
              }
            </div>
          </div>
        </div>
      </section>
      <Footer />
    </div>
    <CookieBanner />
    <TransitionOverlay />
  </main>
  <script>import '../scripts/main';</script>
</Base>
