---
import { getImage, Picture } from 'astro:assets';
import { COMPANY_LOGOS } from '../data/company-logos';
import { PROJECTS } from '../data/projects';

const logos = await Promise.all(
  COMPANY_LOGOS.map(async (logo) => {
    const webp = await getImage({
      src: logo.src,
      format: 'webp',
      width: logo.src.width,
    });
    return {
      ...logo,
      webpSrc: webp.src,
      width: logo.src.width,
      height: logo.src.height,
    };
  })
);
const tickerLogos = [...logos, ...logos];
const maxSlideIndex = Math.max(0, PROJECTS.length - 1);
---
<section
  id="work"
  class="sections-caseStudies relative flex flex-col justify-center pt-35 lg:pt-45"
  aria-labelledby="caseStudies-heading"
  ><div class="sections-caseStudies__top transition-hide mx-auto flex w-full max-w-1920 flex-col"
    ><div class="relative"
      ><h2 class="sr-only">Our Work</h2
      ><h2
        id="caseStudies-heading"
        class="relative z-20 mb-120 flex justify-center gap-20 heading-3xl text-darkPurple uppercase lg:-mb-10 lg:gap-120"
        ><span class="sections-caseStudies__headingLeft font-offBit101 font-normal">Our</span
        ><span class="sections-caseStudies__headingRight font-offBit">Work</span
        ><span
          class="sections-caseStudies__headingOverlay mouse-target absolute inset-x-0 top-0 h-[80%] w-full"
        ></span></h2
      ><div
        class="parts-stickerSlider absolute bottom-40 left-1/2 z-20 flex w-[200vw] -translate-x-1/2 justify-center lg:hidden"
        ><div class="slider flex w-max min-w-max items-center"
          >{
            tickerLogos.map((logo) => (
              <div class="slider-sticker -mx-10">
                <picture class="parts-webPicture">
                  <img
                    alt={logo.alt}
                    src={logo.webpSrc}
                    width={logo.width}
                    height={logo.height}
                    class="max-h-150 object-contain max-w-150 h-full w-auto"
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                  />
                </picture>
              </div>
            ))
          }</div></div></div
    ><p
      class="parts-smileyText xm:px-0 mx-auto mb-20 w-full px-15 text-center heading-lg text-darkPurple uppercase sm:w-6/12 lg:mb-34 3xl:w-4/12"
      style="font-kerning: none; text-rendering: optimizeSpeed"
      ><span class="sr-only">We work with startups, growing businesses and ambitious brands.</span
      ><span aria-hidden="true" role="presentation" style="font-kerning: none; text-rendering: optimizeSpeed"
        >We work with startups, growing businesses and ambitious brands.</span
      ></p
    ><div class="mx-auto mb-40 lg:mb-80"
      ><svg
        class="svgs-wrappedArrowDown mx-auto block w-40 min-w-40 text-purple lg:w-50 lg:min-w-50"
        viewBox="0 0 50 20"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <rect x="50" y="16" width="4" height="4" transform="rotate(-180 50 16)" fill="currentColor" />
        <rect y="4" width="4" height="4" fill="currentColor" />
        <rect x="50" y="12" width="4" height="4" transform="rotate(-180 50 12)" fill="currentColor" />
        <rect y="8" width="4" height="4" fill="currentColor" />
        <rect x="50" y="8" width="4" height="4" transform="rotate(-180 50 8)" fill="currentColor" />
        <rect y="12" width="4" height="4" fill="currentColor" />
        <rect x="46" y="20" width="4" height="4" transform="rotate(-180 46 20)" fill="currentColor" />
        <rect x="4" width="4" height="4" fill="currentColor" />
        <rect x="46" y="4" width="4" height="4" transform="rotate(-180 46 4)" fill="currentColor" />
        <rect x="4" y="16" width="4" height="4" fill="currentColor" />
        <rect x="27" y="4" width="4" height="4" transform="rotate(90 27 4)" fill="currentColor" />
        <rect x="35" y="4" width="4" height="4" transform="rotate(90 35 4)" fill="currentColor" />
        <rect x="31" y="8" width="4" height="4" transform="rotate(90 31 8)" fill="currentColor" />
        <rect x="27" y="12" width="4" height="4" transform="rotate(90 27 12)" fill="currentColor" />
        <rect x="27" y="16" width="4" height="4" transform="rotate(-180 27 16)" fill="currentColor" />
        <rect x="23" y="12" width="4" height="4" transform="rotate(-180 23 12)" fill="currentColor" />
        <rect x="19" y="8" width="4" height="4" transform="rotate(-180 19 8)" fill="currentColor" /></svg></div></div
  ><div class="mx-auto flex w-full max-w-1920 flex-col"
    ><div class="relative z-20 px-15 lg:px-42"
      ><div class="mb-30 flex flex-col items-center gap-36 lg:mb-36 lg:flex-row lg:items-end lg:gap-20"
        ><p
          class="transition-hide max-w-327 text-center font-nohemi text-[16px] leading-[105%] text-darkPurple lg:text-left"
          >From startups preparing their first launch to established businesses upgrading their systems, we have the
          expertise to help every stage of growth.</p
        ></div
      ><div
        class="parts-caseStudySlider mb-64"
        aria-describedby="slider-instructions"
        aria-label={`Showing all ${PROJECTS.length} projects`}
        ><div id="slider-instructions" class="sr-only" aria-live="polite">
          Use arrow keys to navigate between projects, or tab to focus individual slides </div
        ><div
          class="parts-caseStudySlider__wrapper mb-50 flex w-max gap-16 lg:mb-66 lg:gap-38"
          role="group"
          aria-label="Undertaken projects"
          >{
            PROJECTS.map((project) => (
              <article
                class="parts-caseStudyCard aspect-505/615 w-240 sm:w-360 lg:w-[26vw] lg:max-w-500 transition-hide parts-caseStudySlider__slide"
                data-case-study-id={project.id}
                tabindex="0"
              >
                <div class="parts-caseStudyCard__inner relative h-full w-full overflow-hidden rounded-8 lg:rounded-16">
                  <Picture
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    src={project.src}
                    alt={project.alt}
                    width={1000}
                    widths={[300, 500, 750, 1000]}
                    sizes="(min-width: 1923px) 500px, (min-width: 1024px) 26vw, (min-width: 640px) 360px, 240px"
                    quality={55}
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                    pictureAttributes={{ class: 'parts-webPicture' }}
                    class="w-full h-full object-cover rounded-8 lg:rounded-16 lg:opacity-0 parts-caseStudyCard__image"
                    data-case-study-id={project.id}
                  />
                  <div class="parts-caseStudyCard__title absolute bottom-9 left-8 z-10 flex items-center gap-7 rounded-6 bg-neonGreen px-5 py-9 sm:bottom-15 sm:left-15 lg:bottom-27 lg:left-33 lg:gap-12 lg:rounded-8 lg:py-10 lg:pr-14 lg:pl-16">
                    <svg
                      class="svgs-cross block w-7 min-w-7 text-darkPurple lg:w-9 lg:min-w-9"
                      viewBox="0 0 12 12"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                      aria-hidden="true"
                    >
                      <rect x="4" y="8" width="4" height="4" transform="rotate(-90 4 8)" fill="currentColor" />
                      <rect x="8" y="4" width="4" height="4" transform="rotate(-90 8 4)" fill="currentColor" />
                      <rect y="4" width="4" height="4" transform="rotate(-90 0 4)" fill="currentColor" />
                      <rect y="12" width="4" height="4" transform="rotate(-90 0 12)" fill="currentColor" />
                      <rect x="8" y="12" width="4" height="4" transform="rotate(-90 8 12)" fill="currentColor" />
                    </svg>
                    <div class="relative overflow-hidden">
                      <h3 class="parts-caseStudyCard__textInner heading-sm text-darkPurple uppercase">{project.title}</h3>
                      <span
                        aria-hidden="true"
                        class="parts-caseStudyCard__textInner absolute inset-x-0 top-full heading-sm text-darkPurple uppercase"
                      >
                        {project.title}
                      </span>
                    </div>
                  </div>
                  <div class="parts-caseStudyCard__categories absolute top-9 right-8 z-10 flex items-center gap-6 rounded-40 rounded-tr-none bg-white px-12 py-6 sm:top-15 sm:right-15 lg:top-27 lg:right-33 lg:gap-8 lg:px-18 lg:py-10">
                    {project.categories.map((cat, catIdx) => (
                      <>
                        {catIdx > 0 && (
                          <svg
                            class="svgs-doubleSlash block w-16 min-w-16 -translate-y-1 text-darkPurple lg:w-20 lg:min-w-20"
                            viewBox="0 0 18 10"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                            aria-hidden="true"
                          >
                            <rect x="8" y="9.27246" width="3.09091" height="3.09091" transform="rotate(-90 8 9.27246)" fill="currentColor" />
                            <rect x="11.0938" y="6.18066" width="3.09091" height="3.09091" transform="rotate(-90 11.0938 6.18066)" fill="currentColor" />
                            <rect x="14.1797" y="3.09082" width="3.09091" height="3.09091" transform="rotate(-90 14.1797 3.09082)" fill="currentColor" />
                            <rect y="9.27246" width="3.09091" height="3.09091" transform="rotate(-90 0 9.27246)" fill="currentColor" />
                            <rect x="3.09375" y="6.18066" width="3.09091" height="3.09091" transform="rotate(-90 3.09375 6.18066)" fill="currentColor" />
                            <rect x="6.17969" y="3.09082" width="3.09091" height="3.09091" transform="rotate(-90 6.17969 3.09082)" fill="currentColor" />
                          </svg>
                        )}
                        <span class="heading-sm text-darkPurple uppercase">{cat}</span>
                      </>
                    ))}
                  </div>
                </div>
              </article>
            ))
          }</div
        ><div
          class="parts-caseStudySlider__pagination transition-hide flex flex-col items-center justify-center lg:flex-row"
          ><div
            class="rounded-40 rounded-tl-none bg-darkPurple/10 px-20 py-16"
            role="group"
            aria-label="Slider progress indicator"
            ><div class="parts-caseStudySlider__paginationInner relative flex items-center gap-12 lg:gap-16"
              ><div
                class="parts-caseStudySlider__paginationControl absolute top-1/2 left-0 z-10 h-20 min-h-20 w-18 min-w-18 -translate-x-1/2 -translate-y-1/2 cursor-grab rounded-6 bg-purple"
                role="slider"
                tabindex="0"
                aria-label="Slider position control"
                aria-valuemin="0"
                aria-valuemax={maxSlideIndex}
                aria-valuenow="0"
                aria-valuetext={`Slide 1 of ${PROJECTS.length}`}
              ></div></div></div></div
        ><div id="slider-announcement" class="sr-only" aria-live="polite">Viewing project 1 of {PROJECTS.length}</div></div
      ></div
    ></div
  >{
    logos.map((logo) => (
      <picture class="parts-webPicture">
        <img
          alt=""
          src={logo.webpSrc}
          width={logo.width}
          height={logo.height}
          class="max-h-120 object-contain max-w-200 sticker pointer-events-none invisible absolute top-0 left-0 h-1 w-1"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
          draggable="false"
        />
      </picture>
    ))
  }
</section>
