---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Header from '../components/Header.astro';
import ServicesHero from '../components/ServicesHero.astro';
import ContactBlock from '../components/ContactBlock.astro';
import CalEmbed from '../components/CalEmbed.astro';
import ServicesSidebarNav from '../components/ServicesSidebarNav.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import TransitionOverlay from '../components/TransitionOverlay.astro';
import { EMAIL } from '../data/contact';
import { contactPageSchema } from '../lib/schema';
import { brandify } from '../lib/brand';

const title = 'Contact Decbricks: Book a Call or Start Your Project';
const description =
  'Book a 30-minute or 1-hour Google Meet discovery call or send your project brief to our Chennai team for custom software, AI and growth work.';
// Hero body: owner-supplied SEO description (docs/Implementation-plan.md §4.2).
const heroBody =
  'Book a call or send us a brief. Tell us what you’re building and we’ll reply with how we’d approach it.';
// Smiley line: derived from the page's own supplied H1 strings — the original
// template copy must not ship here (open-items.md C2/B2).
const smileyCopy = 'Start your digital project with Decbricks.';
// 5B paragraph copy was never supplied (brief §4.2 B is referenced but absent
// from the repo — open-items.md A15). Blocks render with the supplied H2/H3
// and a neutral navigation sentence; verbatim paragraphs slot in when given.
const startProjectBody =
    'Every Decbricks project starts with a conversation. We listen to your goals, your audience, your timeline and your constraints, and we ask the questions that help us understand what success looks like for you. Within a few days you receive a written proposal covering scope, deliverables, timeline and pricing, so you know exactly what you’re getting before any work begins. Once you approve it, we agree on an advance and a milestone schedule, and we kick off.\n From there, we build in clear stages and share progress as we go, so you can see the work take shape instead of waiting for a big reveal. Depending on the project, we may bring in trusted developers, designers or other specialists to strengthen the team. We stay responsible for coordinating the work, and everyone involved follows the same confidentiality and security standards. We allow a generous 5-8 days for you to review each stage, and your feedback shapes the work through 2-3 revision rounds, depending on the scope of the project. If you need more rounds, we’re happy to negotiate them on mutually agreed terms.\n When everything is approved and the final payment is received, we hand over the finished deliverables along with the files, access and documentation you need to run them on your own. Ownership of the final work passes to you at that point. After launch, we stay available to answer questions, fix anything that doesn’t behave as agreed, and help with what comes next.';
const startProjectParagraphs = startProjectBody
  .split('\n')
  .map((p) => p.trim())
  .filter(Boolean);
const bookingChips = ['Free, no commitment', '30 min or 1 hour', 'Google Meet'] as const;

if (import.meta.env.DEV && !EMAIL) {
  console.warn('[decbricks] EMAIL is empty — "Prefer email?" row in #book-a-call will omit mailto link.');
}

const sidebarItems = [
  { id: 'book-a-call', number: '01', navLabel: 'Book a Call' },
  { id: 'start-a-project', number: '02', navLabel: 'Start a Project' },
];
---

<Base
  title={title}
  description={description}
  canonical="/contact"
  ogTitle={title}
  ogDescription={description}
  schema={contactPageSchema(description)}
  bodyClass="bg-darkPurple"
>

    <main id="main-content" class="layout overflow-hidden bg-darkPurple">
      <Loader />
      <div class="page page-contact bg-darkPurple">
        <Header />
        <ServicesHero
          srTitle="Contact Decbricks"
          headingParts={['Talk', 'With Us...']}
          body={heroBody}
          navItems={[
            { id: 'book-a-call', navLabel: 'Book a Call' },
            { id: 'start-a-project', navLabel: 'Start a Project' },
          ]}
          navLabel="Contact"
        />
        <section
          data-theme="light"
          class="sections-servicesList relative overflow-hidden bg-darkPurple"
          aria-label="Contact Decbricks"
        >
          <div
            class="rounded-10 bg-white px-9 pt-10 pb-40 lg:rounded-24 lg:px-20 lg:pt-25 lg:pb-50 xl:px-25 xl:pt-30 xl:pb-60 3xl:px-35 3xl:pt-35 3xl:pb-70 4xl:px-35 4xl:pt-40 4xl:pb-80"
          >
            <div
              class="mx-auto flex w-full max-w-1850 flex-col gap-40 lg:gap-55 xl:gap-65 3xl:gap-80 4xl:gap-95"
            >
              <ContactBlock
                id="book-a-call"
                number="01"
                eyebrow="Book a Call"
                title="Book a Meeting"
                class="booking-card"
                headingClass="booking-heading"
                hideGhostNumber={true}
              >
                <ul class="booking-chips" aria-label="Call details">
                  {bookingChips.map((chip) => (
                    <li class="booking-chip">{chip}</li>
                  ))}
                </ul>

                <div class="booking-split">
                  <div class="booking-info">
                    <p class="booking-intro">
                        Tell us what you're building, and we'll show you how we'd bring it to life.
                        <br> Choose a time that works for you, and the meeting will be added straight to your calendar.
                        <br> Share a little about your goals, timeline, and budget so we can come prepared.
                        <br> You'll speak directly with the people responsible for planning, building, and delivering your project.
                    </p>
                  </div>

                  <div class="booking-embed">
                    <CalEmbed />
                  </div>
                </div>
              </ContactBlock>

              <ContactBlock
                id="start-a-project"
                number="02"
                eyebrow="Start a Project"
                title="Your Project, Step by Step"
                h3="Here’s what happens after you say hello."
                hideGhostNumber={true}
              >
                <div class="project-process">
                  {startProjectParagraphs.map((paragraph) => (
                    <div class="project-step">
                      <p
                        class="project-step__text"
                        set:html={brandify(paragraph)}
                      />
                    </div>
                  ))}
                  <div class="project-step">
                    <p class="project-step__text">
                      Not sure where to start? <a href="/services" class="underline">See our seven services</a> or{' '}
                      <a href="/about" class="underline">read how we work</a>.
                    </p>
                  </div>
                </div>
              </ContactBlock>
            </div>
          </div>
        </section>
        <ServicesSidebarNav items={sidebarItems} ariaLabel="Contact" />
        <ContactForm smileyCopy={smileyCopy} />
        <Footer />
      </div>
      <CookieBanner />
      <TransitionOverlay />
    </main>
  <script>import '../scripts/main';</script>
</Base>
