---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Header from '../components/Header.astro';
import ServicesHero from '../components/ServicesHero.astro';
import ServiceBlock from '../components/ServiceBlock.astro';
import ServicesSidebarNav from '../components/ServicesSidebarNav.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import TransitionOverlay from '../components/TransitionOverlay.astro';
import { SERVICES, SERVICES_SECTION_HEADER, SCOPE_SECTION } from '../data/services';
import AboutBlock from '../components/AboutBlock.astro';
import { getBlockImagePreloads } from '../lib/image-preload';
import { servicesPageSchema } from '../lib/schema';

const title = 'Our Services: Software, AI, Design & Digital Growth';
const description =
  'Explore seven integrated Decbricks services: strategy, brand design, web and mobile apps, AI automation, SEO and B2B client outreach support.';
const imagePreloads = await getBlockImagePreloads(
  SERVICES.flatMap((service) =>
    service.media.kind === 'image'
      ? [{ src: service.media.src, quality: 55, position: service.media.position }]
      : []
  ).slice(0, 1)
);
---

<Base
  title={title}
  description={description}
  canonical="/services"
  ogTitle={title}
  ogDescription={description}
  schema={servicesPageSchema(description)}
  themeColor="#800020"
  bodyClass="bg-darkPurple"
>
  <Fragment slot="head">
    {imagePreloads.map((img) => (
      <link
        rel="preload"
        as="image"
        type={img.type}
        imagesrcset={img.imagesrcset}
        imagesizes={img.imagesizes}
        fetchpriority={img.fetchpriority}
      />
    ))}
  </Fragment>
  
    <main id="main-content" class="layout overflow-hidden bg-darkPurple">
      <Loader />
      <div class="page page-services bg-white">
        <Header />
        <ServicesHero />
        <section
          data-theme="light"
          class="sections-servicesList relative overflow-hidden bg-darkPurple"
          aria-label="Our services"
        >
          <div
            class="rounded-10 bg-white px-9 pt-10 pb-40 lg:rounded-24 lg:px-20 lg:pt-25 lg:pb-50 xl:px-25 xl:pt-30 xl:pb-60 3xl:px-35 3xl:pt-35 3xl:pb-70 4xl:px-35 4xl:pt-40 4xl:pb-80"
          >
            <div
              class="mx-auto flex w-full max-w-1850 flex-col gap-40 lg:gap-55 xl:gap-65 3xl:gap-80 4xl:gap-95"
            >
              {SERVICES.map((service, index) => <ServiceBlock service={service} index={index} />)}
              <AboutBlock section={SCOPE_SECTION} index={SERVICES.length} />
            </div>
          </div>
        </section>
        <ServicesSidebarNav />
        <ContactForm smileyCopy={SERVICES_SECTION_HEADER.intro} />
        <Footer />
      </div>
      <CookieBanner />
      <TransitionOverlay />
    </main>
  <script>import '../scripts/main';</script>
</Base>
