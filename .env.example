# Production site origin & indexing gate (set PUBLIC_ENV=production on live deploy).
PUBLIC_SITE_URL=https://decbricks.com
PUBLIC_ENV=
PUBLIC_GSC_VERIFICATION=

# Google Tag Manager container (consent-gated analytics, src/scripts/analytics.ts).
# Defaults to GTM-MRLF44ZP (owner-supplied). Loads only after the visitor grants
# analytics consent, and only on production builds.
PUBLIC_GTM_ID=GTM-MRLF44ZP

# Contact form delivery endpoint (Formspree form ID URL, e.g. https://formspree.io/f/xxxxxxx).
# Inlined at BUILD time — must also be set in the hosting provider's build environment.
# Leave empty to disable remote submission (the form then degrades to a safe fallback).
PUBLIC_CONTACT_ENDPOINT=

# Optional build-time overrides for Cal.com booking & public contact email
# (defaults live in src/data/contact.ts and src/data/site.ts).
PUBLIC_CAL_LINK=decbricks-team/meet
PUBLIC_CAL_BOOKING_URL=https://cal.com/decbricks-team/meet
PUBLIC_CAL_NAMESPACE=meet
PUBLIC_CONTACT_EMAIL=hello@decbricks.com

# Optional preview testimonials flag
PUBLIC_SHOW_PLACEHOLDER_TESTIMONIALS=false
